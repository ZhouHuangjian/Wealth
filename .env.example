# Local-only example. Copy to .env and replace all CHANGE_ME values with independent
# random hexadecimal secrets (python3 -c 'import secrets; print(secrets.token_hex(32))').
# Never use real data with example credentials; .env must not be committed.
POSTGRES_DB=wealth
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_ADMIN
DB_OWNER_PASSWORD=CHANGE_ME_MIGRATION_OWNER
DB_APP_PASSWORD=CHANGE_ME_RUNTIME_APP
RABBITMQ_PASSWORD=CHANGE_ME_QUEUE
DJANGO_SECRET_KEY=CHANGE_ME_DJANGO_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
WEALTH_PORT=8000
# Backend commands running on the host need separate URLs with a published local
# DB port. Compose containers get service-name URLs directly in compose.yaml.
# DATABASE_URL=postgresql://wealth_app:YOUR_SECRET@127.0.0.1:5432/wealth
# DATABASE_URL_ADMIN=postgresql://wealth_owner:YOUR_SECRET@127.0.0.1:5432/wealth

# Keep the backup secret outside this repository and outside the backup directory.
# WEALTH_BACKUP_KEY_FILE=/absolute/private/location/wealth-backup.key
