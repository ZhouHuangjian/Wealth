# Replace SERVER_IP before installing in /etc/nginx/sites-available/wealth.
# Obtain the IP certificate using the ACME webroot before enabling TLS.
log_format wealth '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                 '$status $body_bytes_sent $request_time';

server {
    listen 80;
    listen [::]:80;
    server_name SERVER_IP;
    server_tokens off;
    access_log /var/log/nginx/wealth.access.log wealth;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/wealth-acme;
        default_type text/plain;
    }
    location / { return 301 https://SERVER_IP$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name SERVER_IP;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/SERVER_IP/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/SERVER_IP/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:wealth_tls:10m;
    ssl_session_timeout 1d;
    client_max_body_size 12m;
    access_log /var/log/nginx/wealth.access.log wealth;
    error_log /var/log/nginx/wealth.error.log warn;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Replace all client-supplied forwarding headers at this trusted edge.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
    }
}
