# 复制为 .env 后，npm run dev / npm start 会读取。本文件不含真实凭据。
PORT=4317
DATA_DIR=private
SEED_DEMO=true
# 可选：校准档案清单的路径；相对路径按启动目录解析。未设置或空值沿用项目默认目录。
# 将清单、它指向的档案、reply-tests/round01/round01-summary.json 和
# reply-tests/round02/round02-summary.json 按原相对结构放在同一个学习目录。
# PROFILE_MANIFEST_PATH=/绝对路径/学习目录/current-profile.json

# 可选：受信的 Codex CLI 可执行文件路径；不能通过浏览器修改。
# 不填时使用服务进程 PATH 中的 codex。登录凭据必须属于运行服务的系统用户。
# XIANZHI_CODEX_BIN=/usr/local/bin/codex
# 生成超时，1000–180000 毫秒，默认 60000。
# XIANZHI_CODEX_TIMEOUT_MS=60000

# 可选：Mac 微信只读查询工具。默认使用下面的已安装位置，不会自动安装或获取密钥。
# 只运行 query；采集仍需在工作台绑定会话并手动开启，服务重启后暂停。
# XIANZHI_WECHAT_BIN=/Applications/WeChatExporter.app/Contents/Resources/wx-cli

# 可选：Mac 把生成的候选回复上传到自己的云端草稿箱。
# 仅上传有限的草稿数据，不把原始聊天、习惯档案或模型凭据迁移到服务器。
# 目标必须为 HTTPS 完整接收 URL；token 至少 32 字符，与云端 DRAFT_INBOX_TOKEN 相同。
# 配置后可手动同步；自动同步仍需在界面开启，默认关闭。
# DRAFT_SYNC_URL=https://你的域名/api/sync/drafts
# DRAFT_SYNC_TOKEN=
# 云端才需要配置接收 token；与 BRIDGE_TOKEN 分离，不赋予聊天接收/微信发送能力。
# DRAFT_INBOX_TOKEN=

# 可选的外部消息桥接。默认留空，所有演练只发生在本机。
# BRIDGE_TOKEN 至少 32 个字符。消息桥接需要你自己的适配程序。
# 可先只配 BRIDGE_TOKEN 接收来信并生成草稿；出站两项留空即不可发送。
BRIDGE_TOKEN=
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_TOKEN=
