  "source_paths": [
    {
      "path": "app/api/fund.js:1066-1116",
      "meaning": "Sources 2/3 call the Sina original endpoint."
    },
    {
      "path": "app/api/fund.js:1134-1154",
      "meaning": "Source4 reads community Supabase gztime/gszzl/gzstatus only; baseline and calculation method are not provided there."
    },
    {
      "path": "app/api/fund.js:1484-1489",
      "meaning": "That app derives missing reference price from latest NAV and source rate; this approach is not imported."
    },
    {
      "path": "app/lib/fundHelpers.js:176-192",
      "meaning": "NAV freshness is inferred using subscription confirmation days and trading-day lag; this inference is not imported."
    },
    {
      "path": "app/hooks/useHoldingProfit.js:22-38",
      "meaning": "Today reference detection uses Beijing date prefix; overnight QDII session is not distinguished from the next economic NAV date."
    },
    {
      "path": "app/hooks/useHoldingProfit.js:182-240",
      "meaning": "Today return and holding return use different price bases. Current holdings use formal NAV; estimated return uses source rate."
    },
    {
      "path": "app/hooks/useRefreshManager.js:177-207,382-490,535-542",
      "meaning": "Actual fundDailyEarnings writes use latestNavDate=data.jzrq or historical NAV row dates. The current module-local record helper writes those dates; the exported recordDailyEarnings helper is not called by the current refresh path. Displaying a latest update under today does not move stored formal earnings into today."
    }
  ],
